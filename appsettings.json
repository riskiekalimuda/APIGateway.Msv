{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "MicroserviceApp"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catchall}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "RegisteredUser",
        "Match": {
          "Path": "/api/order/{**catchall}"
        }
      },
      "purchase-route": {
        "ClusterId": "purchase-cluster",
        "AuthorizationPolicy": "RegisteredUser",
        "Match": {
          "Path": "/api/purchase/{**catchall}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5100" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5012" }
        }
      },
      "purchase-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5219" }
        }
      }
    } //,
    //"Clusters": {
    //  "auth-cluster": {
    //    "Destinations": {
    //      "destination1": { "Address": "http://auth-service:8080" }
    //    }
    //  },
    //  "order-cluster": {
    //    "Destinations": {
    //      "destination1": { "Address": "http://order-service:8080" }
    //    }
    //  },
    //  "purchase-cluster": {
    //    "Destinations": {
    //      "destination1": { "Address": "http://purchase-service:8080" }
    //    }
    //  }
    //}
  }, // <-- Tanda kurung kurawal penutup ReverseProxy dipindah ke sini
  "AllowedHosts": "*"
}
